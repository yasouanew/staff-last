<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Rosta</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
		Export compliance: the app only uses encryption that is exempt from the
		US export documentation requirement (e.g. HTTPS/TLS via the OS). Declaring
		this here lets App Store Connect skip the manual export-compliance question
		on every upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
	  <!-- Do not change NSAllowsArbitraryLoads to true, or you will risk app rejection! -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!--
		Required for FCM. `remote-notification` lets the OS wake the app for a silent
		data push so the inbox can refresh in the background; without it, background
		messages are only delivered when the user taps the notification.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
		Full-screen opt-in for notched devices.

		Registering `UILaunchScreen` is what tells iOS the app draws its own
		content edge to edge on notched/Dynamic Island hardware. Without it, a
		build linked against the iOS 14+ SDK is treated as a legacy app and the
		window is inset *below* the status bar: the root view then starts after the
		bar, `react-native-safe-area-context` reports `insets.top = 0`, and every
		`insets.top`-padded header (the Home hero most visibly) collapses its top
		padding while still painting a full-height background — the tall empty blue
		band with crowded content seen on iPhone.

		The dictionary is intentionally empty: it is the opt-in *marker*. The brand
		splash is drawn in JS by `AppBootGate`/`SplashScreen`, so no UIKit launch
		configuration (image, background colour) is needed here.

		`UILaunchStoryboardName` is deliberately *not* also declared. The two keys
		describe the same slot in two generations of the OS, and shipping both has
		historically been the configuration in which the inset behaviour persists.
		`LaunchScreen.storyboard` remains in the project, but is no longer
		registered as the launch screen.
	-->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!--
		Status-bar ownership — kept at `false` deliberately.

		This is the React Native default and it must not be flipped to `true` in this
		app. With `true`, iOS asks the navigator's view controller for the bar style
		via `childForStatusBarStyle`, and any container in the stack that does not
		answer blanks the bar's appearance — observed on device as an entirely white
		status bar (white background, invisible clock/battery/wifi glyphs).

		The app already drives the bar correctly through `<StatusBar>` in JS
		([`ThemedStatusBar`](App.tsx:98) app-wide, plus the focus-scoped override in
		the Home hero), which writes via `UIApplication.setStatusBarStyle` under this
		`false` setting and works without a status-bar delegate in the navigator.
	-->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
