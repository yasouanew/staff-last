# Production environment. Run with: npm run android:prod / npm run ios:prod
# Live backend host.

API_BASE_URL=https://staffsass.infinitsofts.online/api/v1
APP_PUBLIC_URL=https://staffsass.infinitsofts.online

API_TIMEOUT_MS=20000

APP_ENV=production
APP_DEBUG=false
APP_DEEP_LINK_SCHEME=staffapp

# Version reported to POST /auth/login as app_version. Keep in sync with
# package.json "version" and Xcode MARKETING_VERSION.
APP_VERSION=1.0.4

FCM_ENABLED=true
FCM_ANDROID_CHANNEL_ID=staffsaas_default

# Auth token policy: advisory access-token lifetime (seconds) used to derive an
# expiry when the backend does not return one (0 disables derivation), and the
# clock-skew allowance before that expiry is enforced.
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_TOKEN_EXPIRY_SKEW_SECONDS=60

# API retry policy (safe/idempotent requests only) and error reporting.
API_RETRY_MAX_ATTEMPTS=3
API_RETRY_BASE_DELAY_MS=300
API_RETRY_MAX_DELAY_MS=5000
# No crash/analytics provider is wired, so monitoring stays off: enabling it
# without a provider only produces a "collecting nothing" warning (see
# src/services/monitoring/bootstrap.ts). Flip to true once a provider is installed.
MONITORING_ENABLED=false
# MONITORING_PROVIDER=sentry
# MONITORING_DSN=
