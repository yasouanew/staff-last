# Environment configuration template.
# Copy to .env.development / .env.staging / .env.production (see package.json scripts).
# Never commit real .env.* files — they are gitignored.

# Laravel API base URL. Must include the /api/v1 prefix used by the backend.
# Example (Android emulator -> host machine): http://10.0.2.2:8000/api/v1
# Example (device on LAN):                    http://192.168.1.20:8000/api/v1
# Example (production):                       https://api.staffsaas.example.com/api/v1
API_BASE_URL=https://api.staffsaas.example.com/api/v1

# Public URL of the Laravel app (without /api/v1). Used to resolve relative
# attachment paths returned by the API (e.g. leave request attachments on the
# "public" disk: `${APP_PUBLIC_URL}/storage/<path>`).
APP_PUBLIC_URL=https://app.staffsaas.example.com

# Network timeout in milliseconds applied to the shared axios client.
API_TIMEOUT_MS=15000

# Environment label: development | staging | production.
APP_ENV=development

# Enables verbose API/query logging. Keep "false" in staging/production.
APP_DEBUG=true

# Deep link scheme registered by the native projects.
APP_DEEP_LINK_SCHEME=staffapp

# --- API retry policy ----------------------------------------------------------
# Automatic retries apply to SAFE/IDEMPOTENT requests (GET/HEAD/OPTIONS) only. Mutating
# writes are never auto-retried (they are handled by the durable outbox instead).
API_RETRY_MAX_ATTEMPTS=3
API_RETRY_BASE_DELAY_MS=300
API_RETRY_MAX_DELAY_MS=5000

# --- Error/crash reporting -----------------------------------------------------
# Set MONITORING_ENABLED=true and wire a provider (Sentry/Bugsnag/Crashlytics) via
# installErrorReporter(); see docs/error-handling.md. Without a wired provider, errors
# are still redacted and logged locally but not aggregated off-device.
MONITORING_ENABLED=false
# MONITORING_PROVIDER=sentry
# MONITORING_DSN=

# --- Authentication token policy -----------------------------------------------
# The bearer token is stored in the iOS Keychain / Android Keystore (never
# AsyncStorage). Sanctum computes expiry server-side and does not return it, so the
# client derives an advisory expiry from AUTH_TOKEN_TTL_SECONDS. Set to 0 to disable
# derivation (expiry then "unknown"; the server 401 is the only authority).
AUTH_TOKEN_TTL_SECONDS=86400

# Clock-skew allowance (seconds) before a computed expiry is enforced, so a device
# clock running slightly fast cannot discard a token the server still accepts.
AUTH_TOKEN_EXPIRY_SKEW_SECONDS=60

# --- Firebase Cloud Messaging -------------------------------------------------
# Firebase configuration is consumed from the native config files
# (android/app/google-services.json and ios/StaffSaaSMobile/GoogleService-Info.plist).
# Those files are gitignored and must be supplied per environment; the app's package
# name ("com.staffsaasmobile") must match the Android app registered in Firebase, or
# the SDK throws "default app has not been initialized" at launch.
# Set to "false" to ship a build without push notifications wired up.
FCM_ENABLED=true

# Android notification channel used for FCM messages.
# Must match BOTH:
#   - android/app/src/main/res/values/strings.xml -> default_notification_channel_id
#   - the `android.notification.channel_id` the backend sends in the FCM payload
# A mismatch causes Android 8+ to silently drop the notification.
FCM_ANDROID_CHANNEL_ID=staffsaas_default
